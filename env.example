# ─── Required for sign-in ──────────────────────────────────────────────
HUB_PASSWORD=
SESSION_SECRET=

# ─── AI generation (Quick draft tab) ──────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Buildium (used by Process action in Phase 2) ──────────────────────
BUILDIUM_CLIENT_ID=
BUILDIUM_CLIENT_SECRET=

# ─── ClickSend (used by Process action in Phase 2) ─────────────────────
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=

# ─── Google service account (Sheets, Gmail send, Drive upload) ─────────
GOOGLE_SA_EMAIL=vara-ops-service@vara-ops.iam.gserviceaccount.com
GOOGLE_SA_PRIVATE_KEY=
SUPPORT_EMAIL=support@varasuites.com
GOOGLE_SHEET_ID=

# Folder under "My Drive" or a Shared Drive where tenant subfolders live.
# Service account must have Editor access to this folder.
# Find the ID in the folder's URL: drive.google.com/drive/folders/[ID]
DRIVE_ROOT_FOLDER_ID=

# ─── PandaDoc (lease e-sign) ──────────────────────────────────────────
# Sign up at pandadoc.com → Settings → Integrations → API → Create API Key
PANDADOC_API_KEY=

# Template UUID. Create a lease template in PandaDoc with merge fields:
#   {{tenant_name}}, {{tenant_email}}, {{tenant_phone}},
#   {{location}}, {{suite}}, {{lease_start_date}}, {{weekly_rent}}
# And one signature field for role "Tenant".
# Copy the template ID from its URL.
PANDADOC_LEASE_TEMPLATE_ID=

# Webhook signing key. In PandaDoc → Workspace settings → Webhooks → Add webhook:
#   URL: https://vara-ops-hub.vercel.app/api/pandadoc-webhook
#   Events: document_state_changed
#   Generate a "shared key" and paste it here.
PANDADOC_WEBHOOK_KEY=

# ─── Vercel KV (auto-injected when you create a KV store) ──────────────
# Vercel → Storage → Create Database → KV → connect to project.
# These get added automatically:
#   KV_REST_API_URL
#   KV_REST_API_TOKEN

# ─── Vercel Blob (auto-injected when you create a Blob store) ──────────
# Vercel → Storage → Create Database → Blob → connect to project.
# This gets added automatically:
#   BLOB_READ_WRITE_TOKEN
